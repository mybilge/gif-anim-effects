  "files": {
    "effect.frag": {
      "encoding": "utf8",
      "content": "uniform float u_scale;\nuniform float u_tilt;\nuniform float u_thickness;\nconst float TAU = 6.28318530718;\nvec4 sourceAt(vec2 uv) {\n  if (any(lessThan(uv, vec2(0.0))) || any(greaterThan(uv, vec2(1.0)))) return vec4(0.0);\n  return texture(u_source, uv);\n}\nmat2 rotation(float a) { float c = cos(a), s = sin(a); return mat2(c, -s, s, c); }\nvoid main() {\n  vec2 aspect = vec2(u_resolution.x / u_resolution.y, 1.0);\n  vec2 p = (v_uv - 0.5) * aspect * 2.0 / u_scale;\n  fragColor = vec4(0.0);\n  for (int i = 0; i < 96; i++) {\n    vec3 q = vec3(p, 1.5 - float(i) / 95.0 * 3.0);\n    q.yz = rotation(u_tilt) * q.yz;\n    q.xz = rotation(-TAU * u_progress) * q.xz;\n    if (abs(q.z) > u_thickness * 0.5) continue;\n    vec4 c = sourceAt(vec2(q.x / aspect.x, q.y) * 0.5 + 0.5);\n    if (c.a > 0.01) {\n      c.rgb *= abs(q.z) > u_thickness * 0.3 ? 1.0 : 0.65;\n      fragColor = c;\n      return;\n    }\n  }\n}\n"
    },
