  "files": {
    "effect.frag": {
      "encoding": "utf8",
      "content": "uniform float u_amount;\nconst float TAU = 6.28318530718;\nvec4 sourceAt(vec2 uv) {\n  if (any(lessThan(uv, vec2(0.0))) || any(greaterThan(uv, vec2(1.0)))) return vec4(0.0);\n  return texture(u_source, uv);\n}\nvoid main() {\n  vec2 uv = v_uv;\n  float wave = sin(TAU * (uv.x * 2.0 - u_progress));\n  uv.y += wave * uv.x * 0.15 * u_amount;\n  vec4 c = sourceAt(uv);\n  c.rgb *= 0.85 + 0.15 * cos(TAU * (uv.x * 2.0 - u_progress));\n  fragColor = c;\n}\n"
    },
