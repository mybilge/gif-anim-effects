  "files": {
    "effect.frag": {
      "encoding": "utf8",
      "content": "int sourceIndex = 0;\nuniform float u_amount;\nvec4 sourceAt(vec2 uv) {\n  if (any(lessThan(uv, vec2(0.0))) || any(greaterThan(uv, vec2(1.0)))) return vec4(0.0);\n  return imageAt(sourceIndex, uv);\n}\nvec4 over(vec4 front, vec4 back) { return front + back * (1.0 - front.a); }\nvoid main() {\n  vec4 color = vec4(0.0);\n  for (int i = 0; i < 3; i++) {\n    sourceIndex = i;\n    float layer = float(i);\n    vec2 uv = vec2(fract(v_uv.x + u_progress * (layer + 1.0)), v_uv.y);\n    uv = (uv - 0.5) / (0.5 + layer * 0.2) + 0.5;\n    vec4 c = sourceAt(uv) * (i == 0 ? 1.0 : (0.3 + layer * 0.3) * u_amount);\n    color = over(c, color);\n  }\n  fragColor = color;\n}\n"
    },
