  "files": {
    "effect.frag": {
      "encoding": "utf8",
      "content": "uniform float u_amount;\nconst float TAU = 6.28318530718;\nvec4 sourceAt(vec2 uv) {\n  if (any(lessThan(uv, vec2(0.0))) || any(greaterThan(uv, vec2(1.0)))) return vec4(0.0);\n  return texture(u_source, uv);\n}\nmat2 rotation(float a) { float c = cos(a), s = sin(a); return mat2(c, -s, s, c); }\nvoid main() {\n  vec2 p = rotation(sin(TAU * u_progress) * u_amount * 0.1) * (v_uv - 0.5 - vec2(0.0, sin(TAU * u_progress) * u_amount * 0.1));\n  fragColor = sourceAt(p / 0.8 + 0.5);\n}\n"
    },
