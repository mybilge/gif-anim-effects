  "files": {
    "effect.frag": {
      "encoding": "utf8",
      "content": "uniform float u_amount;\nvec4 sourceAt(vec2 uv) {\n  if (any(lessThan(uv, vec2(0.0))) || any(greaterThan(uv, vec2(1.0)))) return vec4(0.0);\n  return texture(u_source, uv);\n}\nvoid main() {\n  float p = u_progress;\n  float beat = exp(-pow((p - 0.2) * 24.0, 2.0)) + 0.7 * exp(-pow((p - 0.4) * 24.0, 2.0));\n  fragColor = sourceAt((v_uv - 0.5) / (0.8 + beat * u_amount * 0.2) + 0.5);\n}\n"
    },
