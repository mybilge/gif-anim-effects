        "id": "amount",
        "type": "slider",
        "label": {
          "tr": "Miktar",
          "en": "Amount"
        },
        "description": {
          "tr": "Miktar değerini ayarlar.",
          "en": "Adjusts amount."
        },
        "min": 0,
        "max": 1,
        "step": 0.05,
        "default": 0.6
      }
    ],
    "durationBehavior": "loop",
