    "id": "heartbeat",
    "name": {
      "tr": "Kalp atışı",
      "en": "Heartbeat"
    },
    "description": {
      "tr": "Görsel her döngüde iki kısa vuruşla büyüyüp küçülür.",
      "en": "Pulses the picture with two short beats per cycle."
    },
    "category": "distortion",
    "kind": "animation",
    "version": "1.0.0",
    "minimumEngineVersion": "0.4.0",
