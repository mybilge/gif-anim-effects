  "files": {
    "effect.frag": {
      "encoding": "utf8",
      "content": "uniform float u_width;\nuniform float u_angle;\nuniform float u_amount;\nconst float TAU = 6.28318530718;\nvoid main() {\n  vec4 c = texture(u_source, v_uv);\n  vec2 aspect = u_resolution / min(u_resolution.x, u_resolution.y);\n  float angle = radians(u_angle);\n  float position = dot((v_uv - 0.5) * aspect, vec2(cos(angle), sin(angle)));\n  float shine = pow(0.5 + 0.5 * cos(TAU * (position * 0.65 - u_progress)), 2.0 / u_width);\n  vec3 rainbow = 0.5 + 0.5 * cos(TAU * (position * 1.5 - u_progress) + vec3(0.0, 2.0943951, 4.1887902));\n  c.rgb += (vec3(c.a) - c.rgb) * rainbow * shine * u_amount;\n  fragColor = c;\n}\n"
    },
