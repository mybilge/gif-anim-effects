{
  "metadata": {
    "schemaVersion": 1,
    "id": "holographic-foil",
    "name": {
      "tr": "Holografik folyo",
      "en": "Holographic foil"
    },
    "description": {
      "tr": "Gökkuşağı renkli ışık fotoğrafın üzerinde folyo gibi dolaşır.",
      "en": "Rainbow light sweeps across the picture like holographic foil."
    },
    "category": "filters",
    "kind": "filter",
    "version": "1.0.0",
    "minimumEngineVersion": "0.4.0",
    "engineType": "glsl",
    "entry": "effect.frag",
    "parameters": [
      {
        "id": "width",
        "type": "slider",
        "label": {
          "tr": "Parlama genişliği",
          "en": "Shine width"
        },
        "description": {
          "tr": "Işık bandının genişliğini ayarlar.",
          "en": "Sets the width of the light band."
        },
        "min": 0.1,
        "max": 0.8,
        "step": 0.05,
        "default": 0.3
      },
      {
        "id": "angle",
        "type": "slider",
        "label": {
          "tr": "Yön",
          "en": "Direction"
        },
        "description": {
          "tr": "Işık bandının açısını derece olarak ayarlar.",
          "en": "Sets the light band angle in degrees."
        },
        "min": 0,
        "max": 360,
        "step": 5,
        "default": 45
      },
      {
        "id": "amount",
        "type": "slider",
        "label": {
          "tr": "Renk yoğunluğu",
          "en": "Color intensity"
        },
        "description": {
          "tr": "Folyo parlamasının gücünü ayarlar; sıfırda fotoğraf korunur.",
          "en": "Sets the foil strength; zero preserves the picture."
        },
        "min": 0,
        "max": 1,
        "step": 0.05,
        "default": 0.7
      }
