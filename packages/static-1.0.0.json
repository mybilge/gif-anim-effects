        "id": "scale",
        "type": "slider",
        "label": {
          "tr": "Boyut",
          "en": "Size"
        },
        "description": {
          "tr": "Boyut değerini ayarlar.",
          "en": "Adjusts size."
        },
        "min": 0.4,
        "max": 1.2,
        "step": 0.05,
        "default": 1
