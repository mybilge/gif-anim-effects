    "id": "static",
    "name": {
      "tr": "Durağan görsel",
      "en": "Still picture"
    },
    "description": {
      "tr": "Kaynak görseli hareketsiz tutar; hareketli filtreler sonradan eklenebilir.",
      "en": "Keeps the source still; animated filters can be added afterward."
    },
