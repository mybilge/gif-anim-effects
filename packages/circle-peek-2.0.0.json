  "files": {
    "effect.frag": {
      "encoding": "utf8",
      "content": "int sourceIndex = 0;\nuniform float u_amount;\nconst float TAU = 6.28318530718;\nvec4 sourceAt(vec2 uv) {\n  if (any(lessThan(uv, vec2(0.0))) || any(greaterThan(uv, vec2(1.0)))) return vec4(0.0);\n  return imageAt(sourceIndex, uv);\n}\nvoid main() {\n  float local = fract(u_progress * float(inputCount));\n  sourceIndex = int(floor(u_progress * float(inputCount) + 0.5));\n  float depth = (0.5 - 0.5 * cos(TAU * local)) * (inputCount > 1 ? 1.3 : 0.5 + u_amount * 0.8);\n  vec2 center = vec2(0.5, 0.5 - depth);\n  vec2 p = (v_uv - center) * vec2(u_resolution.x / u_resolution.y, 1.0) / 0.8;\n  fragColor = length(p) <= 0.5 ? sourceAt(p + 0.5) : vec4(0.0);\n}\n"
    },
