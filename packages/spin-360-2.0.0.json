{
  "metadata": {
    "schemaVersion": 1,
    "id": "spin-360",
    "name": {
      "tr": "Perspektif dönüş",
      "en": "Perspective spin"
    },
    "description": {
      "tr": "Görseli yatay veya dikey eksende tam tur döndürür. İsteğe bağlı ek görseller kullanır.",
      "en": "Rotates the image through a full turn about either axis. Supports optional additional images."
    },
    "category": "spins",
    "kind": "animation",
    "version": "2.0.0",
    "minimumEngineVersion": "0.6.0",
    "engineType": "glsl",
    "entry": "effect.frag",
    "parameters": [
      {
        "id": "perspective",
        "type": "slider",
        "label": {
          "tr": "Perspektif",
          "en": "Perspective"
        },
        "description": {
          "tr": "Derinlik etkisi.",
          "en": "Depth strength."
        },
        "min": 0,
        "max": 1,
        "step": 0.05,
        "default": 0.4
      },
      {
        "id": "reverse",
        "type": "toggle",
        "label": {
          "tr": "Ters yön",
          "en": "Reverse"
        },
        "description": {
          "tr": "Dönüş yönünü tersine çevirir.",
          "en": "Reverses the rotation."
        },
        "default": false
      },
      {
        "id": "axis",
        "type": "choice",
        "label": {
          "tr": "Eksen",
          "en": "Axis"
        },
        "description": {
