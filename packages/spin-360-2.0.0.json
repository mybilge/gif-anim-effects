  "files": {
    "effect.frag": {
      "encoding": "utf8",
      "content": "int sourceIndex = 0;\nuniform float u_perspective;\nuniform bool u_reverse;\nuniform int u_axis;\nvoid main() {\n  sourceIndex = cos(6.28318530718 * u_progress) < 0.0 ? 1 : 0;\n  float a = 6.28318530718 * u_progress * (u_reverse ? -1.0 : 1.0);\n  float c = cos(a), s = sin(a);\n  vec2 p = (v_uv - 0.5) * 2.0;\n  if (u_axis == 1) p = p.yx;\n  float denominator = c - s * p.x * u_perspective * 0.5;\n  if (abs(denominator) < 0.00001) { fragColor = vec4(0.0); return; }\n  float x = p.x / denominator;\n  float y = p.y * (1.0 + s * x * u_perspective * 0.5);\n  vec2 uv = vec2(x, y) * 0.5 + 0.5;\n  if (u_axis == 1) uv = uv.yx;\n  bool inside = all(greaterThanEqual(uv, vec2(0.0))) && all(lessThanEqual(uv, vec2(1.0)));\n  fragColor = inside ? imageAt(sourceIndex, uv) : vec4(0.0);\n}\n"
    },
