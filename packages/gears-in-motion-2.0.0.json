  "files": {
    "effect.frag": {
      "encoding": "utf8",
      "content": "int sourceIndex = 0;\nuniform float u_amount;\nvec4 sourceAt(vec2 uv) {\n  if (any(lessThan(uv, vec2(0.0))) || any(greaterThan(uv, vec2(1.0)))) return vec4(0.0);\n  return imageAt(sourceIndex, uv);\n}\nvoid main() {\n  float phase = u_progress * 4.0, direction = floor(phase), travel = mix(-0.125, 1.125, fract(phase));\n  sourceIndex = int(direction);\n  vec2 center = direction < 1.0 ? vec2(travel, 0.5) : direction < 2.0 ? vec2(0.5, 1.0 - travel) : direction < 3.0 ? vec2(1.0 - travel, 0.5) : vec2(0.5, travel);\n  fragColor = sourceAt((v_uv - center) / (0.2 + u_amount * 0.1) + 0.5);\n}\n"
    },
