  "files": {
    "effect.frag": {
      "encoding": "utf8",
      "content": "uniform float u_amount;\nconst float TAU = 6.28318530718;\nvec4 sourceAt(vec2 uv) {\n  if (any(lessThan(uv, vec2(0.0))) || any(greaterThan(uv, vec2(1.0)))) return vec4(0.0);\n  return texture(u_source, uv);\n}\nvoid main() {\n  vec2 center = 0.5 + vec2(sin(TAU * u_progress), sin(TAU * u_progress * 2.0)) * 0.22;\n  vec2 p = v_uv - center;\n  float lens = 1.0 - smoothstep(0.0, 0.28, length(p));\n  vec2 uv = center + p / (1.0 + lens * u_amount * 1.5);\n  fragColor = sourceAt(uv);\n}\n"
    },
