{
  "metadata": {
    "schemaVersion": 1,
    "id": "scroll-down",
    "name": {
      "tr": "Aşağı kaydır",
      "en": "Scroll down"
    },
    "description": {
      "tr": "Görseli tuval sınırından sararak kesintisiz kaydırır.",
      "en": "Scrolls the image continuously, wrapping at canvas edges."
    },
    "category": "motion",
    "kind": "animation",
    "version": "1.0.0",
    "minimumEngineVersion": "0.4.0",
    "engineType": "glsl",
    "entry": "effect.frag",
    "parameters": [
      {
        "id": "scale",
        "type": "slider",
        "label": {
          "tr": "Görsel boyutu",
          "en": "Picture size"
        },
        "description": {
          "tr": "Görsel boyutu değerini ayarlar.",
          "en": "Adjusts picture size."
        },
        "min": 0.4,
        "max": 1,
        "step": 0.05,
        "default": 0.85
      }
    ],
    "durationBehavior": "loop",
    "loopBehavior": "seamless",
    "randomness": "none",
    "capabilities": {
      "alpha": true,
      "webgl": 2,
      "platforms": [
        "android",
        "windows",
        "web"
      ],
      "cost": "low"
    },
    "thumbnail": "thumbnail.webp",
    "preview": "preview.webp",
    "assets": [
