{
  "metadata": {
    "schemaVersion": 1,
    "id": "pixelate",
    "name": {
      "tr": "Piksel blokları",
      "en": "Pixel blocks"
    },
    "description": {
      "tr": "Çözünürlükten bağımsız boyutlu piksel blokları.",
      "en": "Pixel blocks with resolution independent size."
    },
    "category": "filters",
    "kind": "filter",
    "version": "1.0.0",
    "minimumEngineVersion": "0.3.0",
    "engineType": "glsl",
    "entry": "effect.frag",
    "parameters": [
      {
        "id": "blockSize",
        "type": "slider",
        "label": {
          "tr": "Blok boyutu",
          "en": "Block size"
        },
        "description": {
          "tr": "Tuvalin kısa kenarının payı.",
          "en": "Fraction of the shorter canvas edge."
        },
        "min": 0.005,
        "max": 0.1,
        "step": 0.005,
        "default": 0.025
      }
    ],
    "durationBehavior": "static",
    "loopBehavior": "none",
    "randomness": "none",
    "capabilities": {
      "alpha": true,
      "webgl": 2,
      "platforms": [
        "android",
        "windows",
        "web"
      ],
      "cost": "low"
    },
    "thumbnail": "thumbnail.webp",
    "preview": "preview.webp",
    "assets": [
      {
        "path": "thumbnail.webp",
        "source": "Original GIF Anim synthetic calibration image, rendered by tooling",
        "license": "CC0-1.0"
      },
      {
        "path": "preview.webp",
        "source": "Original GIF Anim synthetic calibration image, rendered by tooling",
        "license": "CC0-1.0"
      }
    ]
  },
  "files": {
    "effect.frag": {
      "encoding": "utf8",
      "content": "uniform float u_blockSize;\nvoid main() {\n  float size = u_blockSize * min(u_resolution.x, u_resolution.y);\n  vec2 cells = u_resolution / size;\n  vec2 uv = (floor(v_uv * cells) + 0.5) / cells;\n  fragColor = texture(u_source, uv);\n}\n"
    },
    "thumbnail.webp": {
      "encoding": "base64",
      "content": ""
    },
    "preview.webp": {
      "encoding": "base64",
      "content": ""
    }
  },
