  "files": {
    "effect.frag": {
      "encoding": "utf8",
      "content": "uniform float u_amount;\nvec4 sourceAt(vec2 uv) {\n  if (any(lessThan(uv, vec2(0.0))) || any(greaterThan(uv, vec2(1.0)))) return vec4(0.0);\n  return texture(u_source, uv);\n}\nvoid main() {\n  float fold = sin(3.14159265359 * u_progress) * u_amount;\n  vec2 uv = vec2((v_uv.x - 0.5) / (1.0 - fold * 0.5) + 0.5, v_uv.y);\n  float ridge = abs(fract(uv.x * 8.0) * 2.0 - 1.0);\n  uv.y = (uv.y - 0.5) / (1.0 - fold * ridge * 0.18) + 0.5;\n  vec4 c = sourceAt(uv); c.rgb *= 1.0 - fold * ridge * 0.4;\n  fragColor = c;\n}\n"
    },
