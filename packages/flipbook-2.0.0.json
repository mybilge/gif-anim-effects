        "path": "preview.webp",
        "source": "Original GIF Anim synthetic calibration image, rendered by tooling",
        "license": "CC0-1.0"
      }
    ],
    "imageInputs": 100
  },
  "files": {
    "effect.frag": {
      "encoding": "utf8",
      "content": "int sourceIndex = 0;\nuniform float u_amount;\nconst float TAU = 6.28318530718;\nvec4 sourceAt(vec2 uv) {\n  if (any(lessThan(uv, vec2(0.0))) || any(greaterThan(uv, vec2(1.0)))) return vec4(0.0);\n  return imageAt(sourceIndex, uv);\n}\nvec4 over(vec4 front, vec4 back) { return front + back * (1.0 - front.a); }\nvoid main() {\n  if (inputCount > 1) {\n    float cycle = u_progress * float(inputCount), phase = fract(cycle);\n    sourceIndex = int(floor(cycle)) + (phase < 0.5 ? 0 : 1);\n    float width = abs(cos(TAU * phase));\n    if (width < 0.001) { fragColor = vec4(0.0); return; }\n    vec2 uv = vec2((v_uv.x - 0.5) / width + 0.5, v_uv.y);\n    fragColor = sourceAt(uv);\n    fragColor.rgb *= 1.0 - u_amount * (1.0 - width) * 0.6;\n    return;\n  }\n  vec4 base = sourceAt(v_uv);\n  float a = TAU * u_progress, c = cos(a);\n  if (sin(a) >= 0.0 && v_uv.x < 0.5) base = vec4(0.0);\n  vec2 uv = vec2(0.5 + (v_uv.x - 0.5) / (abs(c) < 0.001 ? 0.001 : c), v_uv.y);\n  if (uv.x >= 0.0 && uv.x <= 0.5 && sin(a) >= 0.0) {\n    vec4 page = sourceAt(uv); page.rgb *= 1.0 - u_amount * (1.0 - abs(c)) * 0.6;\n    base = over(page, base);\n  }\n  fragColor = base;\n}\n"
    },
