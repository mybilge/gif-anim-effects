{
  "metadata": {
    "schemaVersion": 1,
    "id": "flipbook",
    "name": {
      "tr": "Sayfa çevir",
      "en": "Page turn"
    },
    "description": {
      "tr": "Görselin sol yarısı orta çizgiden sağa doğru sayfa gibi katlanır. İsteğe bağlı ek görseller kullanır.",
      "en": "Folds the left half of the image over the center like a page. Supports optional additional images."
    },
    "category": "grids",
    "kind": "animation",
    "version": "2.0.0",
    "minimumEngineVersion": "0.6.0",
    "engineType": "glsl",
    "entry": "effect.frag",
    "parameters": [
      {
        "id": "amount",
        "type": "slider",
        "label": {
          "tr": "Miktar",
          "en": "Amount"
        },
        "description": {
          "tr": "Miktar değerini ayarlar.",
          "en": "Adjusts amount."
        },
        "min": 0,
        "max": 1,
        "step": 0.05,
        "default": 0.6
      }
    ],
    "durationBehavior": "loop",
    "loopBehavior": "seamless",
    "randomness": "none",
    "capabilities": {
      "alpha": true,
      "webgl": 2,
      "platforms": [
        "android",
        "windows",
        "web"
      ],
      "cost": "low"
    },
    "thumbnail": "thumbnail.webp",
    "preview": "preview.webp",
    "assets": [
