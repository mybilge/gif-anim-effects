{
  "metadata": {
    "schemaVersion": 1,
    "id": "mirror",
    "name": {
      "tr": "Ayna",
      "en": "Mirror"
    },
    "description": {
      "tr": "Seçilen eksenin bir yarısını diğer yarıya aynalar.",
      "en": "Reflects one half of the selected axis onto the other."
    },
    "category": "filters",
    "kind": "filter",
    "version": "1.0.0",
    "minimumEngineVersion": "0.4.0",
    "engineType": "glsl",
