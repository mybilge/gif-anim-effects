          "tr": "Eksen",
          "en": "Axis"
        },
        "description": {
          "tr": "Aynalanacak eksen.",
          "en": "The axis to mirror."
        },
        "default": 0,
        "options": [
          {
            "value": 0,
            "label": {
              "tr": "Yatay",
              "en": "Horizontal"
            }
          },
          {
            "value": 1,
            "label": {
              "tr": "Dikey",
              "en": "Vertical"
            }
