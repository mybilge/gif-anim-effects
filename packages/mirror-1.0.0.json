  "files": {
    "effect.frag": {
      "encoding": "utf8",
      "content": "uniform int u_axis;\nvec4 sourceAt(vec2 uv) {\n  if (any(lessThan(uv, vec2(0.0))) || any(greaterThan(uv, vec2(1.0)))) return vec4(0.0);\n  return texture(u_source, uv);\n}\nvoid main() {\n  vec2 uv = v_uv;\n  if (u_axis == 0) uv.x = abs(uv.x - 0.5) * 2.0;\n  else uv.y = abs(uv.y - 0.5) * 2.0;\n  fragColor = sourceAt(uv);\n}\n"
    },
