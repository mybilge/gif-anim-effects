  "files": {
    "effect.frag": {
      "encoding": "utf8",
      "content": "uniform float u_amount;\nconst float TAU = 6.28318530718;\nvec4 sourceAt(vec2 uv) {\n  if (any(lessThan(uv, vec2(0.0))) || any(greaterThan(uv, vec2(1.0)))) return vec4(0.0);\n  return texture(u_source, uv);\n}\nmat2 rotation(float a) { float c = cos(a), s = sin(a); return mat2(c, -s, s, c); }\nvec4 over(vec4 front, vec4 back) { return front + back * (1.0 - front.a); }\nvoid main() {\n  vec4 color = vec4(0.0);\n  for (int i = 0; i < 2; i++) {\n    float side = float(i) * 2.0 - 1.0;\n    vec2 center = vec2(0.5 + side * cos(3.14159265359 * u_progress) * (0.4 + u_amount * 0.15), 0.25 + sin(3.14159265359 * u_progress) * 0.5);\n    vec2 p = rotation(side * sin(TAU * u_progress) * 0.6) * (v_uv - center);\n    color = over(sourceAt(p / 0.42 + 0.5), color);\n  }\n  fragColor = color;\n}\n"
    },
