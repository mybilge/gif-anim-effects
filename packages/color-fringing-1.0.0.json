  "files": {
    "effect.frag": {
      "encoding": "utf8",
      "content": "uniform float u_amount;\nvec4 sourceAt(vec2 uv) {\n  if (any(lessThan(uv, vec2(0.0))) || any(greaterThan(uv, vec2(1.0)))) return vec4(0.0);\n  return texture(u_source, uv);\n}\nvoid main() {\n  vec2 offset = (v_uv - 0.5) * u_amount * 0.05;\n  vec4 c = sourceAt(v_uv), r = sourceAt(v_uv + offset), b = sourceAt(v_uv - offset);\n  vec3 straight = vec3(r.a > 0.0 ? r.r / r.a : 0.0, c.a > 0.0 ? c.g / c.a : 0.0, b.a > 0.0 ? b.b / b.a : 0.0);\n  fragColor = vec4(straight * c.a, c.a);\n}\n"
    },
