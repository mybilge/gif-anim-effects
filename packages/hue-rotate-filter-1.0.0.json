  "files": {
    "effect.frag": {
      "encoding": "utf8",
      "content": "uniform float u_amount;\nconst float TAU = 6.28318530718;\nvec4 sourceAt(vec2 uv) {\n  if (any(lessThan(uv, vec2(0.0))) || any(greaterThan(uv, vec2(1.0)))) return vec4(0.0);\n  return texture(u_source, uv);\n}\nvoid main() {\n  vec4 c = sourceAt(v_uv);\n  float a = TAU * u_amount;\n  vec3 axis = normalize(vec3(1.0));\n  vec3 rgb = c.rgb * cos(a) + cross(axis, c.rgb) * sin(a) + axis * dot(axis, c.rgb) * (1.0 - cos(a));\n  fragColor = vec4(clamp(rgb, vec3(0.0), vec3(c.a)), c.a);\n}\n"
    },
