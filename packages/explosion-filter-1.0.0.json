  "files": {
    "effect.frag": {
      "encoding": "utf8",
      "content": "uniform float u_amount;\nvec4 sourceAt(vec2 uv) {\n  if (any(lessThan(uv, vec2(0.0))) || any(greaterThan(uv, vec2(1.0)))) return vec4(0.0);\n  return texture(u_source, uv);\n}\nvoid main() {\n  vec4 color = vec4(0.0);\n  vec2 p = v_uv - 0.5;\n  for (int i = 0; i < 12; i++) color += sourceAt(v_uv - p * float(i) / 12.0 * u_amount * 0.7);\n  fragColor = color / 12.0;\n}\n"
    },
