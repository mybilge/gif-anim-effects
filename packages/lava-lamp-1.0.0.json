  "files": {
    "effect.frag": {
      "encoding": "utf8",
      "content": "uniform float u_amount;\nconst float TAU = 6.28318530718;\nvec4 sourceAt(vec2 uv) {\n  if (any(lessThan(uv, vec2(0.0))) || any(greaterThan(uv, vec2(1.0)))) return vec4(0.0);\n  return texture(u_source, uv);\n}\nvoid main() {\n  vec2 p = v_uv * 6.0;\n  float field = sin(p.x + sin(p.y + u_progress * TAU)) + cos(p.y - u_progress * TAU);\n  vec4 c = sourceAt(v_uv + vec2(sin(field), cos(field)) * u_amount * 0.025);\n  vec3 tint = 0.5 + 0.5 * cos(field + vec3(0.0, 2.0, 4.0) + u_progress * TAU);\n  c.rgb = mix(c.rgb, tint * c.a, u_amount * 0.5);\n  fragColor = c;\n}\n"
    },
