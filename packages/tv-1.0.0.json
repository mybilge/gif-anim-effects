  "files": {
    "effect.frag": {
      "encoding": "utf8",
      "content": "uniform float u_amount;\nconst float TAU = 6.28318530718;\nvec4 sourceAt(vec2 uv) {\n  if (any(lessThan(uv, vec2(0.0))) || any(greaterThan(uv, vec2(1.0)))) return vec4(0.0);\n  return texture(u_source, uv);\n}\nvoid main() {\n  vec4 c = sourceAt(v_uv);\n  float scan = 0.75 + 0.25 * sin(v_uv.y * 128.0 * TAU);\n  vec3 mask = 0.65 + 0.35 * cos(vec3(0.0, 2.1, 4.2) + v_uv.x * 128.0 * TAU);\n  float band = 0.85 + 0.15 * cos(TAU * (v_uv.y - u_progress));\n  c.rgb *= mix(vec3(1.0), mask * scan * band, u_amount);\n  fragColor = c;\n}\n"
    },
