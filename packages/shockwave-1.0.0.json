  "files": {
    "effect.frag": {
      "encoding": "utf8",
      "content": "uniform float u_amount;\nvec4 sourceAt(vec2 uv) {\n  if (any(lessThan(uv, vec2(0.0))) || any(greaterThan(uv, vec2(1.0)))) return vec4(0.0);\n  return texture(u_source, uv);\n}\nvoid main() {\n  vec2 p = v_uv - 0.5;\n  float r = length(p), ring = u_progress * 0.9;\n  float wave = sin((r - ring) * 80.0) * exp(-pow((r - ring) * 18.0, 2.0));\n  vec2 uv = v_uv + p / max(r, 0.0001) * wave * u_amount * 0.06 * sin(3.14159265359 * u_progress);\n  fragColor = sourceAt(uv);\n}\n"
    },
