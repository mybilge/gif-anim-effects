  "files": {
    "effect.frag": {
      "encoding": "utf8",
      "content": "uniform float u_drops;\nuniform float u_size;\nuniform float u_refraction;\nuint hash(uint x) { x ^= x >> 16; x *= 2146121005u; x ^= x >> 15; x *= 2221713035u; return x ^ (x >> 16); }\nfloat randomValue(uint i) { return float(hash(i + hash(uint(u_seed))) >> 8) / 16777216.0; }\nvec4 sourceAt(vec2 uv) {\n  if (any(lessThan(uv, vec2(0.0))) || any(greaterThan(uv, vec2(1.0)))) return vec4(0.0);\n  return texture(u_source, uv);\n}\nvoid main() {\n  vec2 aspect = u_resolution / min(u_resolution.x, u_resolution.y);\n  vec2 offset = vec2(0.0);\n  float light = 0.0;\n  for (int i = 0; i < 24; i++) {\n    if (float(i) >= u_drops) break;\n    uint id = uint(i) * 3u;\n    vec2 center = vec2(randomValue(id), fract(randomValue(id + 1u) - u_progress));\n    float radius = u_size * mix(0.65, 1.2, randomValue(id + 2u));\n    // Wrap the droplet footprint too, so crossing an edge does not pop.\n    vec2 p = vec2(v_uv.x - center.x, fract(v_uv.y - center.y + 0.5) - 0.5) * aspect / radius;\n    p.y *= 0.75;\n    float mask = 1.0 - smoothstep(0.45, 1.0, dot(p, p));\n    offset += p * radius * mask * 0.45;\n    light += (1.0 - smoothstep(0.08, 0.25, length(p - vec2(-0.3, 0.35)))) * mask * 0.5;\n    float tail = (1.0 - smoothstep(0.035, 0.12, abs(p.x))) * smoothstep(0.8, 1.2, p.y) * (1.0 - smoothstep(1.2, 3.5, p.y));\n    light += tail * 0.08;\n  }\n  vec4 c = sourceAt(v_uv + offset * u_refraction / aspect);\n  c.rgb = mix(c.rgb, vec3(c.a), clamp(light * u_refraction, 0.0, 1.0));\n  fragColor = c;\n}\n"
    },
