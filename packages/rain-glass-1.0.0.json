{
  "metadata": {
    "schemaVersion": 1,
    "id": "rain-glass",
    "name": {
      "tr": "Yağmurlu cam",
      "en": "Rainy glass"
    },
    "description": {
      "tr": "Aşağı süzülen cam damlaları fotoğrafı kırar ve ışığı yansıtır.",
      "en": "Sliding glass droplets refract the picture and catch the light."
    },
    "category": "filters",
    "kind": "filter",
    "version": "1.0.0",
    "minimumEngineVersion": "0.4.0",
    "engineType": "glsl",
    "entry": "effect.frag",
    "parameters": [
      {
        "id": "drops",
        "type": "slider",
        "label": {
          "tr": "Damla yoğunluğu",
          "en": "Droplet density"
        },
        "description": {
          "tr": "Cam üzerindeki damla sayısını ayarlar.",
          "en": "Sets the number of droplets on the glass."
        },
        "min": 4,
        "max": 24,
        "step": 1,
        "default": 16
      },
      {
        "id": "size",
        "type": "slider",
        "label": {
          "tr": "Damla boyutu",
          "en": "Droplet size"
        },
        "description": {
          "tr": "Damla yarıçapını tuvalin kısa kenarına göre ayarlar.",
          "en": "Sets droplet radius relative to the shorter canvas edge."
        },
        "min": 0.025,
        "max": 0.1,
        "step": 0.005,
        "default": 0.05
      },
      {
        "id": "refraction",
        "type": "slider",
        "label": {
          "tr": "Kırılma",
          "en": "Refraction"
        },
        "description": {
          "tr": "Kırılma ve parlamayı ayarlar; sıfırda fotoğraf korunur.",
          "en": "Sets refraction and highlights; zero preserves the picture."
        },
        "min": 0,
        "max": 1,
        "step": 0.05,
        "default": 0.7
      }
    ],
    "durationBehavior": "loop",
    "loopBehavior": "seamless",
