  "files": {
    "effect.frag": {
      "encoding": "utf8",
      "content": "uniform float u_rate;\nuniform float u_strength;\nconst float TAU = 6.28318530718;\nvec4 sourceAt(vec2 uv) {\n  if (any(lessThan(uv, vec2(0.0))) || any(greaterThan(uv, vec2(1.0)))) return vec4(0.0);\n  return texture(u_source, uv);\n}\nmat2 rotation(float a) { float c = cos(a), s = sin(a); return mat2(c, -s, s, c); }\nuint hash(uint x) { x ^= x >> 16; x *= 2146121005u; x ^= x >> 15; x *= 2221713035u; return x ^ (x >> 16); }\nfloat randomValue(vec2 p) { return float(hash(uint(p.x) + hash(uint(p.y) + uint(u_seed) * 31u + 17u)) >> 8) / 16777216.0; }\nvoid main() {\n  float tick = floor(u_time * u_rate);\n  float r = randomValue(vec2(tick, 7.0));\n  int mode = int(floor(r * 6.0));\n  vec2 uv = v_uv;\n  if (mode == 0) uv = rotation(r * TAU) * (uv - 0.5) + 0.5;\n  else if (mode == 1) uv.x = 1.0 - uv.x;\n  else if (mode == 2) uv += sin(uv.yx * 18.0 + r * TAU) * 0.12;\n  else if (mode == 3) uv = (floor(uv * 16.0) + 0.5) / 16.0;\n  else if (mode == 4) uv = (uv - 0.5) / (0.5 + r) + 0.5;\n  vec4 c = sourceAt(uv);\n  if (mode == 5) c.rgb = vec3(c.a) - c.rgb;\n  fragColor = mix(sourceAt(v_uv), c, u_strength * (0.4 + r * 0.6));\n}\n"
    },
