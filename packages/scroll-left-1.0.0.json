        "label": {
          "tr": "Görsel boyutu",
          "en": "Picture size"
        },
        "description": {
          "tr": "Görsel boyutu değerini ayarlar.",
          "en": "Adjusts picture size."
        },
        "min": 0.4,
        "max": 1,
        "step": 0.05,
        "default": 0.85
      }
