    "imageInputs": 100
  },
  "files": {
    "effect.frag": {
      "encoding": "utf8",
      "content": "int sourceIndex = 0;\nuniform float u_amount;\nuniform float u_slats;\nvec4 sourceAt(vec2 uv) {\n  if (any(lessThan(uv, vec2(0.0))) || any(greaterThan(uv, vec2(1.0)))) return vec4(0.0);\n  return imageAt(sourceIndex, uv);\n}\nvoid main() {\n  float local = fract(u_progress * float(inputCount));\n  sourceIndex = int(floor(u_progress * float(inputCount) + 0.5));\n  float open = 1.0 - sin(3.14159265359 * local) * (inputCount > 1 ? 1.0 : u_amount);\n  float mask = step(fract(v_uv.y * u_slats), open);\n  fragColor = sourceAt(v_uv) * mask;\n}\n"
    },
