{
  "metadata": {
    "schemaVersion": 1,
    "id": "shutter",
    "name": {
      "tr": "Panjur",
      "en": "Shutter"
    },
    "description": {
      "tr": "Yatay şeritler panjur gibi açılıp kapanır. İsteğe bağlı ek görseller kullanır.",
      "en": "Horizontal slats open and close like a shutter. Supports optional additional images."
    },
    "category": "glitch",
    "kind": "animation",
    "version": "2.0.0",
    "minimumEngineVersion": "0.6.0",
    "engineType": "glsl",
    "entry": "effect.frag",
    "parameters": [
      {
        "id": "amount",
        "type": "slider",
        "label": {
          "tr": "Miktar",
          "en": "Amount"
        },
        "description": {
          "tr": "Miktar değerini ayarlar.",
          "en": "Adjusts amount."
        },
        "min": 0,
        "max": 1,
        "step": 0.05,
        "default": 0.6
      },
      {
        "id": "slats",
        "type": "slider",
        "label": {
          "tr": "Şerit sayısı",
          "en": "Slats"
        },
        "description": {
          "tr": "Şerit sayısı değerini ayarlar.",
          "en": "Adjusts slats."
        },
        "min": 2,
        "max": 24,
        "step": 1,
        "default": 8
      }
    ],
    "durationBehavior": "loop",
    "loopBehavior": "seamless",
    "randomness": "none",
    "capabilities": {
