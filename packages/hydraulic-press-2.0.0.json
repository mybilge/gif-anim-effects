  "files": {
    "effect.frag": {
      "encoding": "utf8",
      "content": "uniform float u_amount;\nvec4 sourceAt(vec2 uv) {\n  if (any(lessThan(uv, vec2(0.0))) || any(greaterThan(uv, vec2(1.0)))) return vec4(0.0);\n  return texture(u_source, uv);\n}\nfloat box(vec2 low, vec2 high) {\n  vec2 edge = min(v_uv - low, high - v_uv) / fwidth(v_uv);\n  return clamp(min(edge.x, edge.y) + 0.5, 0.0, 1.0);\n}\nvoid main() {\n  float p = u_progress;\n  float restHeight = 0.58;\n  float flatHeight = restHeight * (1.0 - 0.85 * u_amount);\n  float stroke = smoothstep(0.08, 0.46, p) * (1.0 - smoothstep(0.54, 0.72, p));\n  float plateY = mix(0.90, 0.08 + flatHeight, stroke);\n  float recovery = mix(flatHeight, restHeight, smoothstep(0.72, 0.82, p));\n  recovery += 0.10 * u_amount * sin(3.14159265359 * smoothstep(0.78, 0.90, p));\n  // Keep the crushed image flat until the plate has cleared it.\n  float height = min(plateY - 0.08, p < 0.54 ? restHeight : recovery);\n  float squash = 1.0 - height / restHeight;\n  float width = 0.58 + 0.32 * max(squash, 0.0) + 0.08 * min(squash, 0.0);\n  fragColor = sourceAt(vec2((v_uv.x - 0.5) / width + 0.5, (v_uv.y - 0.08) / height));\n\n  float ram = box(vec2(0.42, plateY + 0.07), vec2(0.58, 1.0));\n  fragColor = mix(fragColor, vec4(0.58, 0.61, 0.64, 1.0), ram);\n  float base = box(vec2(0.05, 0.0), vec2(0.95, 0.08));\n  float plate = box(vec2(0.05, plateY), vec2(0.95, plateY + 0.07));\n  fragColor = mix(fragColor, vec4(0.25, 0.27, 0.30, 1.0), max(base, plate));\n  float edge = max(box(vec2(0.05, 0.07), vec2(0.95, 0.08)),\n                   box(vec2(0.05, plateY), vec2(0.95, plateY + 0.01)));\n  fragColor = mix(fragColor, vec4(0.48, 0.50, 0.54, 1.0), edge);\n}\n"
    },
