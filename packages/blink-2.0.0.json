{
  "metadata": {
    "schemaVersion": 1,
    "id": "blink",
    "name": {
      "tr": "Yanıp sön",
      "en": "Blink"
    },
    "description": {
      "tr": "Görselin görünürlüğünü periyodik olarak azaltıp artırır. İsteğe bağlı ek görseller kullanır.",
      "en": "Periodically dims and restores the image visibility. Supports optional additional images."
    },
    "category": "glitch",
    "kind": "animation",
    "version": "2.0.0",
    "minimumEngineVersion": "0.6.0",
    "engineType": "glsl",
    "entry": "effect.frag",
    "parameters": [
      {
        "id": "amount",
        "type": "slider",
        "label": {
          "tr": "Miktar",
          "en": "Amount"
        },
        "description": {
          "tr": "Miktar değerini ayarlar.",
          "en": "Adjusts amount."
        },
        "min": 0,
        "max": 1,
        "step": 0.05,
        "default": 0.6
      }
    ],
    "durationBehavior": "loop",
    "loopBehavior": "seamless",
    "randomness": "none",
    "capabilities": {
      "alpha": true,
      "webgl": 2,
      "platforms": [
        "android",
        "windows",
        "web"
      ],
      "cost": "low"
    },
    "thumbnail": "thumbnail.webp",
    "preview": "preview.webp",
    "assets": [
      {
        "path": "thumbnail.webp",
        "source": "Original GIF Anim synthetic calibration image, rendered by tooling",
        "license": "CC0-1.0"
      },
      {
        "path": "preview.webp",
        "source": "Original GIF Anim synthetic calibration image, rendered by tooling",
        "license": "CC0-1.0"
      }
    ],
    "imageInputs": 100
  },
  "files": {
    "effect.frag": {
      "encoding": "utf8",
      "content": "int sourceIndex = 0;\nuniform float u_amount;\nvec4 sourceAt(vec2 uv) {\n  if (any(lessThan(uv, vec2(0.0))) || any(greaterThan(uv, vec2(1.0)))) return vec4(0.0);\n  return imageAt(sourceIndex, uv);\n}\nvoid main() {\n  float local = fract(u_progress * float(inputCount));\n  sourceIndex = int(floor(u_progress * float(inputCount) + 0.5));\n  float alpha = 1.0 - (inputCount > 1 ? 1.0 : u_amount) * pow(sin(3.14159265359 * local), 4.0);\n  fragColor = sourceAt(v_uv) * alpha;\n}\n"
    },
    "thumbnail.webp": {
      "encoding": "base64",
      "content": ""
    },
    "preview.webp": {
      "encoding": "base64",
      "content": ""
