  "files": {
    "effect.frag": {
      "encoding": "utf8",
      "content": "uniform float u_scale;\nvec4 sourceAt(vec2 uv) {\n  if (any(lessThan(uv, vec2(0.0))) || any(greaterThan(uv, vec2(1.0)))) return vec4(0.0);\n  return texture(u_source, uv);\n}\nvoid main() {\n  vec2 phase = vec2(u_progress * 2.0, u_progress * 4.0);\n  vec2 center = 0.5 + (abs(fract(phase) * 2.0 - 1.0) - 0.5) * (1.0 - u_scale);\n  fragColor = sourceAt((v_uv - center) / u_scale + 0.5);\n}\n"
    },
