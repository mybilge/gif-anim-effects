{
  "metadata": {
    "schemaVersion": 1,
    "id": "corner-bounce",
    "name": {
      "tr": "Köşeden sekme",
      "en": "Corner bounce"
    },
    "description": {
      "tr": "Küçültülen görsel tuvalin kenarlarından sekerek ilerler.",
      "en": "A smaller picture bounces off the edges of the canvas."
    },
    "category": "motion",
    "kind": "animation",
    "version": "1.0.0",
    "minimumEngineVersion": "0.4.0",
    "engineType": "glsl",
    "entry": "effect.frag",
    "parameters": [
