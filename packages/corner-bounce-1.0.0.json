        "id": "scale",
        "type": "slider",
        "label": {
          "tr": "Boyut",
          "en": "Size"
        },
        "description": {
          "tr": "Boyut değerini ayarlar.",
          "en": "Adjusts size."
        },
        "min": 0.15,
        "max": 0.75,
        "step": 0.05,
        "default": 0.35
      }
    ],
    "durationBehavior": "loop",
    "loopBehavior": "seamless",
    "randomness": "none",
