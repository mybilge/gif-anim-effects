  "files": {
    "effect.frag": {
      "encoding": "utf8",
      "content": "uniform float u_rate;\nuniform float u_strength;\nuint hash(uint x) { x ^= x >> 16; x *= 2146121005u; x ^= x >> 15; x *= 2221713035u; return x ^ (x >> 16); }\nvoid main() {\n  uint h = hash(uint(floor(u_time * u_rate)) + uint(u_seed) * 31u + 17u);\n  vec2 r = vec2(float(h & 65535u), float((h >> 16) & 65535u)) / 65535.0;\n  vec2 uv = v_uv + (r - 0.5) * u_strength;\n  bool inside = all(greaterThanEqual(uv, vec2(0.0))) && all(lessThanEqual(uv, vec2(1.0)));\n  fragColor = inside ? texture(u_source, uv) : vec4(0.0);\n}\n"
    },
