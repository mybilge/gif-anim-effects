{
  "metadata": {
    "schemaVersion": 1,
    "id": "random-per-frame",
    "name": {
      "tr": "Zamanlı rastgele",
      "en": "Timed randomness"
    },
    "description": {
      "tr": "FPS yerine zaman adımlarında değişen deterministik rastgele hareket.",
      "en": "Deterministic random motion changing at time steps rather than output frames."
