  "files": {
    "effect.frag": {
      "encoding": "utf8",
      "content": "uniform float u_amount;\nvec4 sourceAt(vec2 uv) {\n  if (any(lessThan(uv, vec2(0.0))) || any(greaterThan(uv, vec2(1.0)))) return vec4(0.0);\n  return texture(u_source, uv);\n}\nvoid main() {\n  vec4 color = vec4(0.0);\n  float radius = pow(sin(3.14159265359 * u_progress), 2.0) * u_amount * 0.08;\n  for (int y = -2; y <= 2; y++) for (int x = -2; x <= 2; x++) color += sourceAt(v_uv + vec2(float(x), float(y)) * radius * 0.5);\n  fragColor = color / 25.0;\n}\n"
    },
