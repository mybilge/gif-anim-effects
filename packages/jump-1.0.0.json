  "files": {
    "effect.frag": {
      "encoding": "utf8",
      "content": "uniform float u_amount;\nvec4 sourceAt(vec2 uv) {\n  if (any(lessThan(uv, vec2(0.0))) || any(greaterThan(uv, vec2(1.0)))) return vec4(0.0);\n  return texture(u_source, uv);\n}\nvoid main() {\n  float height = abs(sin(3.14159265359 * u_progress));\n  vec2 scale = vec2(0.85 + (1.0 - height) * 0.1 * u_amount, 0.85 - (1.0 - height) * 0.15 * u_amount);\n  vec2 center = vec2(0.5, 0.43 + height * 0.22 * u_amount);\n  fragColor = sourceAt((v_uv - center) / scale + 0.5);\n}\n"
    },
