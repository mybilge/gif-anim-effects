{
  "metadata": {
    "schemaVersion": 1,
    "id": "scroll-up",
    "name": {
      "tr": "Yukarı kaydır",
      "en": "Scroll up"
    },
    "description": {
      "tr": "Görseli tuval sınırından sararak kesintisiz kaydırır.",
      "en": "Scrolls the image continuously, wrapping at canvas edges."
    },
    "category": "motion",
    "kind": "animation",
    "version": "1.0.0",
    "minimumEngineVersion": "0.4.0",
    "engineType": "glsl",
    "entry": "effect.frag",
    "parameters": [
