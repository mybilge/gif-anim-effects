  "files": {
    "effect.frag": {
      "encoding": "utf8",
      "content": "uniform float u_scale;\nvec4 sourceAt(vec2 uv) {\n  if (any(lessThan(uv, vec2(0.0))) || any(greaterThan(uv, vec2(1.0)))) return vec4(0.0);\n  return texture(u_source, uv);\n}\nvoid main() {\n  vec2 uv = v_uv;\n  uv.y = fract(uv.y + -1.0 * u_progress);\n  vec2 local = (uv - 0.5) / u_scale + 0.5;\n  fragColor = sourceAt(local);\n}\n"
    },
