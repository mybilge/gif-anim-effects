  "files": {
    "effect.frag": {
      "encoding": "utf8",
      "content": "uniform float u_amount;\nconst float TAU = 6.28318530718;\nvec4 sourceAt(vec2 uv) {\n  if (any(lessThan(uv, vec2(0.0))) || any(greaterThan(uv, vec2(1.0)))) return vec4(0.0);\n  return texture(u_source, uv);\n}\nvoid main() {\n  vec2 grid = vec2(5.0, 1.0), cell = floor(v_uv * grid);\n  vec2 p = fract(v_uv * grid) - 0.5;\n  float a = TAU * u_progress;\n  float cx = cos(a), cy = 1.0;\n  float perspective = 1.0 + sin(a) * p.x * u_amount * 0.5;\n  if (abs(cx) < 0.0001 || abs(cy) < 0.0001) { fragColor = vec4(0.0); return; }\n  vec2 uv = p * perspective / vec2(cx, cy) + 0.5;\n  bool inside = all(greaterThanEqual(uv, vec2(0.0))) && all(lessThanEqual(uv, vec2(1.0)));\n  fragColor = inside ? sourceAt((cell + uv) / grid) : vec4(0.0);\n}\n"
    },
