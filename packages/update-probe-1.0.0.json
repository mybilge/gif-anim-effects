{
  "metadata": {
    "schemaVersion": 1,
    "id": "update-probe",
    "name": {
      "tr": "Güncelleme testi",
      "en": "Update probe"
    },
    "description": {
      "tr": "GitHub güncellemesini cihazda sınamak için geçici efekt; APK'ya gömülmez.",
      "en": "Temporary effect for testing GitHub updates on a device; never bundled in the APK."
    },
    "category": "filters",
    "kind": "filter",
    "version": "1.0.0",
    "minimumEngineVersion": "0.4.0",
    "engineType": "glsl",
    "entry": "effect.frag",
    "parameters": [
      {
        "id": "amount",
        "type": "slider",
        "label": {
          "tr": "Yoğunluk",
          "en": "Strength"
        },
        "description": {
          "tr": "Kayan renk bandının görünürlüğü.",
          "en": "Visibility of the sweeping color band."
        },
        "min": 0,
        "max": 1,
        "step": 0.05,
        "default": 0.8
      },
      {
        "id": "tint",
        "type": "color",
        "label": {
          "tr": "Renk",
          "en": "Color"
        },
        "description": {
          "tr": "Bandın rengi.",
          "en": "Color of the band."
        },
        "default": [
          1,
          0.2,
          0.6,
          1
        ]
      }
    ],
    "durationBehavior": "loop",
    "loopBehavior": "seamless",
    "randomness": "none",
    "capabilities": {
      "alpha": true,
      "webgl": 2,
      "platforms": [
        "android",
        "windows",
        "web"
      ],
      "cost": "low"
    },
    "thumbnail": "thumbnail.webp",
    "preview": "preview.webp",
    "assets": [
      {
        "path": "thumbnail.webp",
        "source": "Original GIF Anim synthetic calibration image, rendered by tooling",
        "license": "CC0-1.0"
      },
      {
        "path": "preview.webp",
        "source": "Original GIF Anim synthetic calibration image, rendered by tooling",
        "license": "CC0-1.0"
      }
    ]
  },
  "files": {
    "effect.frag": {
      "encoding": "utf8",
      "content": "uniform float u_amount;\nuniform vec4 u_tint;\nvoid main() {\n  vec4 c = texture(u_source, v_uv);\n  // A band crosses once per loop; fract keeps t=0 and the loop end equal.\n  float d = abs(fract(v_uv.x - u_progress + 0.5) - 0.5);\n  float band = (1.0 - smoothstep(0.0, 0.15, d)) * u_amount * u_tint.a;\n  fragColor = vec4(mix(c.rgb, u_tint.rgb * c.a, band), c.a);\n}\n"
    },
    "thumbnail.webp": {
      "encoding": "base64",
      "content": ""
    },
    "preview.webp": {
      "encoding": "base64",
      "content": ""
    }
  },
