  "files": {
    "effect.frag": {
      "encoding": "utf8",
      "content": "uniform float u_amount;\nuniform float u_rate;\nvec4 sourceAt(vec2 uv) {\n  if (any(lessThan(uv, vec2(0.0))) || any(greaterThan(uv, vec2(1.0)))) return vec4(0.0);\n  return texture(u_source, uv);\n}\nuint hash(uint x) { x ^= x >> 16; x *= 2146121005u; x ^= x >> 15; x *= 2221713035u; return x ^ (x >> 16); }\nfloat randomValue(vec2 p) { return float(hash(uint(p.x) + hash(uint(p.y) + uint(u_seed) * 31u + 17u)) >> 8) / 16777216.0; }\nvoid main() {\n  float stepTime = floor(u_time * u_rate);\n  vec2 jitter = vec2(randomValue(vec2(stepTime, 0.0)), randomValue(vec2(stepTime, 19.0))) - 0.5;\n  fragColor = sourceAt(v_uv + jitter * u_amount * 0.12);\n}\n"
    },
