  "files": {
    "effect.frag": {
      "encoding": "utf8",
      "content": "uniform float u_amount;\nconst float TAU = 6.28318530718;\nvec4 sourceAt(vec2 uv) {\n  if (any(lessThan(uv, vec2(0.0))) || any(greaterThan(uv, vec2(1.0)))) return vec4(0.0);\n  return texture(u_source, uv);\n}\nvoid main() {\n  float pulse = 0.5 - 0.5 * cos(TAU * u_progress * 2.0);\n  vec2 p = v_uv - 0.5;\n  float perspective = 1.0 + p.y * u_amount;\n  p.y *= 1.4;\n  fragColor = sourceAt(p * perspective / (0.55 + pulse * u_amount * 0.8) + 0.5);\n}\n"
    },
