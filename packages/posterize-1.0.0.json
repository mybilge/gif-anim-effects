{
  "metadata": {
    "schemaVersion": 1,
    "id": "posterize",
    "name": {
      "tr": "Renk basamakları",
      "en": "Posterize"
    },
    "description": {
      "tr": "Görünür renkleri seçilen sayıda basamağa indirir.",
      "en": "Reduces visible colors to a selected number of levels."
    },
    "category": "filters",
    "kind": "filter",
    "version": "1.0.0",
    "minimumEngineVersion": "0.4.0",
    "engineType": "glsl",
    "entry": "effect.frag",
    "parameters": [
      {
        "id": "levels",
        "type": "slider",
        "label": {
          "tr": "Renk basamağı",
          "en": "Color levels"
        },
        "description": {
          "tr": "Renk basamağı değerini ayarlar.",
          "en": "Adjusts color levels."
        },
        "min": 2,
        "max": 16,
        "step": 1,
        "default": 4
      }
    ],
    "durationBehavior": "static",
    "loopBehavior": "none",
    "randomness": "none",
    "capabilities": {
      "alpha": true,
      "webgl": 2,
      "platforms": [
        "android",
        "windows",
        "web"
      ],
      "cost": "low"
    },
    "thumbnail": "thumbnail.webp",
    "preview": "preview.webp",
    "assets": [
      {
        "path": "thumbnail.webp",
        "source": "Original GIF Anim synthetic calibration image, rendered by tooling",
        "license": "CC0-1.0"
      },
      {
        "path": "preview.webp",
        "source": "Original GIF Anim synthetic calibration image, rendered by tooling",
        "license": "CC0-1.0"
      }
    ]
  },
  "files": {
    "effect.frag": {
      "encoding": "utf8",
      "content": "uniform float u_levels;\nvec4 sourceAt(vec2 uv) {\n  if (any(lessThan(uv, vec2(0.0))) || any(greaterThan(uv, vec2(1.0)))) return vec4(0.0);\n  return texture(u_source, uv);\n}\nvoid main() {\n  vec4 c = sourceAt(v_uv);\n  vec3 straight = c.a > 0.0 ? c.rgb / c.a : vec3(0.0);\n  fragColor = vec4(floor(straight * (u_levels - 1.0) + 0.5) / (u_levels - 1.0) * c.a, c.a);\n}\n"
    },
