    "name": {
      "tr": "Yarım dönüş",
      "en": "Half turn"
    },
    "description": {
      "tr": "Her yarım turda yönünü düzelterek görselin ters okunmasını önler. İsteğe bağlı ek görseller kullanır.",
      "en": "Corrects the image every half turn so it never reads backward. Supports optional additional images."
    },
    "category": "spins",
    "kind": "animation",
    "version": "2.0.0",
