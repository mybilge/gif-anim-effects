  "files": {
    "effect.frag": {
      "encoding": "utf8",
      "content": "int sourceIndex = 0;\nuniform float u_amount;\nvec4 sourceAt(vec2 uv) {\n  if (any(lessThan(uv, vec2(0.0))) || any(greaterThan(uv, vec2(1.0)))) return vec4(0.0);\n  return imageAt(sourceIndex, uv);\n}\nvoid main() {\n  sourceIndex = cos(3.14159265359 * u_progress * float(inputCount)) < 0.0 ? 1 : 0;\n  float a = 3.14159265359 * u_progress * float(inputCount);\n  vec2 p = (v_uv - 0.5) * 2.0;\n  float d = abs(cos(a)) - sin(a) * p.x * u_amount * 0.5;\n  if (abs(d) < 0.00001) { fragColor = vec4(0.0); return; }\n  float x = p.x / d;\n  fragColor = sourceAt(vec2(x, p.y * (1.0 + sin(a) * x * u_amount * 0.5)) * 0.5 + 0.5);\n}\n"
    },
