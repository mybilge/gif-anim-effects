{
  "metadata": {
    "schemaVersion": 1,
    "id": "grayscale",
    "name": {
      "tr": "Gri tonlar",
      "en": "Grayscale"
    },
    "description": {
      "tr": "Alpha kanalını koruyarak renkleri griye dönüştürür.",
      "en": "Converts colors to gray while preserving alpha."
    },
    "category": "filters",
    "kind": "filter",
    "version": "1.0.0",
    "minimumEngineVersion": "0.3.0",
    "engineType": "glsl",
    "entry": "effect.frag",
    "parameters": [
      {
        "id": "amount",
        "type": "slider",
        "label": {
          "tr": "Yoğunluk",
          "en": "Strength"
        },
        "description": {
          "tr": "Gri tonlara dönüşüm miktarı.",
          "en": "Amount of grayscale conversion."
        },
        "min": 0,
        "max": 1,
        "step": 0.05,
        "default": 1
      }
    ],
    "durationBehavior": "static",
    "loopBehavior": "none",
    "randomness": "none",
    "capabilities": {
      "alpha": true,
      "webgl": 2,
      "platforms": [
        "android",
        "windows",
        "web"
      ],
      "cost": "low"
    },
    "thumbnail": "thumbnail.webp",
    "preview": "preview.webp",
    "assets": [
      {
        "path": "thumbnail.webp",
        "source": "Original GIF Anim synthetic calibration image, rendered by tooling",
        "license": "CC0-1.0"
      },
      {
        "path": "preview.webp",
        "source": "Original GIF Anim synthetic calibration image, rendered by tooling",
        "license": "CC0-1.0"
      }
    ]
  },
  "files": {
    "effect.frag": {
      "encoding": "utf8",
      "content": "uniform float u_amount;\nvoid main() {\n  vec4 c = texture(u_source, v_uv);\n  float gray = dot(c.rgb, vec3(0.2126, 0.7152, 0.0722));\n  fragColor = vec4(mix(c.rgb, vec3(gray), u_amount), c.a);\n}\n"
    },
