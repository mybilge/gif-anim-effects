  "files": {
    "effect.frag": {
      "encoding": "utf8",
      "content": "uniform float u_amount;\nvec4 sourceAt(vec2 uv) {\n  if (any(lessThan(uv, vec2(0.0))) || any(greaterThan(uv, vec2(1.0)))) return vec4(0.0);\n  return texture(u_source, uv);\n}\nvoid main() {\n  float height = 1.0 - u_amount * 0.85 * pow(sin(3.14159265359 * u_progress), 2.0);\n  fragColor = sourceAt(vec2(v_uv.x, v_uv.y / height));\n  if (v_uv.y > height && v_uv.y < height + 0.06) {\n    float alpha = sourceAt(vec2(v_uv.x, 0.5)).a;\n    float metal = 0.45 + (v_uv.y - height) * 4.0;\n    fragColor = vec4(vec3(metal) * alpha, alpha);\n  }\n}\n"
    },
