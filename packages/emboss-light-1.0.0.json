  "files": {
    "effect.frag": {
      "encoding": "utf8",
      "content": "uniform float u_amount;\nuniform float u_angle;\nuniform vec4 u_color;\nconst float TAU = 6.28318530718;\nfloat heightAt(vec2 uv) {\n  return dot(texture(u_source, clamp(uv, 0.0, 1.0)).rgb, vec3(0.2126, 0.7152, 0.0722));\n}\nvoid main() {\n  vec4 c = texture(u_source, v_uv);\n  vec2 aspect = u_resolution / min(u_resolution.x, u_resolution.y);\n  vec2 stepUv = 0.004 / aspect;\n  vec2 gradient = vec2(heightAt(v_uv + vec2(stepUv.x, 0.0)) - heightAt(v_uv - vec2(stepUv.x, 0.0)),\n    heightAt(v_uv + vec2(0.0, stepUv.y)) - heightAt(v_uv - vec2(0.0, stepUv.y)));\n  vec3 normal = normalize(vec3(-gradient * 40.0 * u_amount, 1.0));\n  float angle = radians(u_angle) + TAU * u_progress;\n  vec3 light = normalize(vec3(cos(angle), sin(angle), 0.8));\n  float diffuse = max(dot(normal, light), 0.0);\n  float shine = pow(max(reflect(-light, normal).z, 0.0), 24.0);\n  vec3 metal = clamp(u_color.rgb * (0.25 + 0.7 * diffuse) + shine * 0.4, 0.0, 1.0);\n  c.rgb = mix(c.rgb, metal * c.a, u_amount * u_color.a);\n  fragColor = c;\n}\n"
    },
