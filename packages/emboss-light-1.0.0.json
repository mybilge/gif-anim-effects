{
  "metadata": {
    "schemaVersion": 1,
    "id": "emboss-light",
    "name": {
      "tr": "Kabartma ışığı",
      "en": "Embossed light"
    },
    "description": {
      "tr": "Dolaşan ışık fotoğrafın parlaklık ayrıntılarını kabartmalı metal gibi aydınlatır.",
      "en": "Moving light illuminates luminance details as an embossed metal surface."
    },
    "category": "filters",
    "kind": "filter",
    "version": "1.0.0",
    "minimumEngineVersion": "0.4.0",
    "engineType": "glsl",
    "entry": "effect.frag",
    "parameters": [
      {
        "id": "amount",
        "type": "slider",
        "label": {
          "tr": "Kabartma gücü",
          "en": "Emboss strength"
        },
        "description": {
          "tr": "Kabartma ve metal görünümünü ayarlar; sıfırda fotoğraf korunur.",
          "en": "Sets emboss and metal strength; zero preserves the picture."
        },
        "min": 0,
        "max": 1,
        "step": 0.05,
        "default": 0.6
      },
      {
        "id": "angle",
        "type": "slider",
        "label": {
          "tr": "Işık açısı",
          "en": "Light angle"
        },
        "description": {
          "tr": "Dolaşan ışığın başlangıç açısını derece olarak ayarlar.",
          "en": "Sets the starting angle of the moving light in degrees."
        },
        "min": 0,
        "max": 360,
        "step": 5,
        "default": 45
      },
      {
        "id": "color",
        "type": "color",
        "label": {
          "tr": "Yüzey rengi",
          "en": "Surface color"
        },
        "description": {
          "tr": "Metal rengini ve etkisinin opaklığını ayarlar.",
          "en": "Sets metal color and its opacity."
        },
        "default": [
          0.75,
          0.65,
          0.4,
          1
        ]
      }
    ],
    "durationBehavior": "loop",
    "loopBehavior": "seamless",
    "randomness": "none",
    "capabilities": {
      "alpha": true,
      "webgl": 2,
      "platforms": [
        "android",
        "windows",
        "web"
      ],
      "cost": "low"
