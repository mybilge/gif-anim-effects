  "files": {
    "effect.frag": {
      "encoding": "utf8",
      "content": "uniform float u_amount;\nconst float TAU = 6.28318530718;\nvec4 sourceAt(vec2 uv) {\n  if (any(lessThan(uv, vec2(0.0))) || any(greaterThan(uv, vec2(1.0)))) return vec4(0.0);\n  return texture(u_source, uv);\n}\nuint hash(uint x) { x ^= x >> 16; x *= 2146121005u; x ^= x >> 15; x *= 2221713035u; return x ^ (x >> 16); }\nfloat randomValue(vec2 p) { return float(hash(uint(p.x) + hash(uint(p.y) + uint(u_seed) * 31u + 17u)) >> 8) / 16777216.0; }\nvoid main() {\n  vec2 cell = floor(v_uv * 16.0), p = fract(v_uv * 16.0) - 0.5;\n  float r = randomValue(cell);\n  float star = exp(-abs(p.x) * 24.0) * exp(-abs(p.y) * 5.0) + exp(-abs(p.y) * 24.0) * exp(-abs(p.x) * 5.0);\n  float light = step(0.75, r) * pow(0.5 + 0.5 * sin(TAU * (u_progress + r)), 4.0) * star * u_amount;\n  vec4 c = sourceAt(v_uv);\n  c.rgb = mix(c.rgb, vec3(c.a), clamp(light, 0.0, 1.0));\n  fragColor = c;\n}\n"
    },
