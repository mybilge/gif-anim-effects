{
  "metadata": {
    "schemaVersion": 1,
    "id": "ink-reveal",
    "name": {
      "tr": "Mürekkep yayılımı",
      "en": "Ink reveal"
    },
    "description": {
      "tr": "Fotoğraf organik mürekkep lekeleriyle açılır ve kapanır; döngü kesintisizdir.",
      "en": "Organic ink patches reveal and hide the picture in a seamless loop."
    },
    "category": "distortion",
    "kind": "animation",
    "version": "1.0.0",
    "minimumEngineVersion": "0.4.0",
    "engineType": "glsl",
    "entry": "effect.frag",
    "parameters": [
      {
        "id": "scale",
        "type": "slider",
        "label": {
          "tr": "Leke ölçeği",
          "en": "Patch scale"
        },
        "description": {
          "tr": "Kısa kenardaki leke ayrıntısını ayarlar; yüksek değer daha küçük lekeler üretir.",
          "en": "Sets patch detail along the shorter edge; higher values make smaller patches."
        },
        "min": 2,
        "max": 12,
        "step": 0.5,
        "default": 5
      },
      {
        "id": "softness",
        "type": "slider",
        "label": {
          "tr": "Kenar yumuşaklığı",
          "en": "Edge softness"
        },
        "description": {
          "tr": "Yayılan mürekkebin kenar geçişini yumuşatır.",
          "en": "Softens the boundary of the spreading ink."
        },
        "min": 0.01,
        "max": 0.2,
        "step": 0.01,
        "default": 0.05
      },
      {
        "id": "direction",
        "type": "choice",
        "label": {
          "tr": "Yayılma yönü",
          "en": "Spread direction"
        },
        "description": {
          "tr": "Mürekkebin hangi yönden yayılacağını seçer.",
          "en": "Selects the direction in which ink spreads."
        },
        "default": 0,
        "options": [
          {
            "value": 0,
            "label": {
              "tr": "Soldan sağa",
              "en": "Left to right"
            }
          },
          {
            "value": 1,
            "label": {
              "tr": "Sağdan sola",
              "en": "Right to left"
            }
          },
          {
            "value": 2,
            "label": {
              "tr": "Aşağıdan yukarı",
              "en": "Bottom to top"
            }
          },
          {
            "value": 3,
            "label": {
              "tr": "Merkezden dışa",
              "en": "From center"
            }
          }
        ]
      }
    ],
    "durationBehavior": "loop",
    "loopBehavior": "seamless",
    "randomness": "seeded",
    "capabilities": {
      "alpha": true,
      "webgl": 2,
      "platforms": [
        "android",
        "windows",
        "web"
      ],
      "cost": "low"
    },
    "thumbnail": "thumbnail.webp",
    "preview": "preview.webp",
    "assets": [
