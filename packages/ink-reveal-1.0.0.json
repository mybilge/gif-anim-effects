    ]
  },
  "files": {
    "effect.frag": {
      "encoding": "utf8",
      "content": "uniform float u_scale;\nuniform float u_softness;\nuniform int u_direction;\nconst float TAU = 6.28318530718;\nuint hash(uint x) { x ^= x >> 16; x *= 2146121005u; x ^= x >> 15; x *= 2221713035u; return x ^ (x >> 16); }\nfloat randomValue(vec2 p) { return float(hash(uint(p.x) + hash(uint(p.y) + uint(u_seed))) >> 8) / 16777216.0; }\nfloat noiseAt(vec2 p) {\n  vec2 cell = floor(p), f = fract(p);\n  f = f * f * (3.0 - 2.0 * f);\n  return mix(mix(randomValue(cell), randomValue(cell + vec2(1.0, 0.0)), f.x),\n    mix(randomValue(cell + vec2(0.0, 1.0)), randomValue(cell + 1.0), f.x), f.y);\n}\nvoid main() {\n  vec2 aspect = u_resolution / min(u_resolution.x, u_resolution.y);\n  vec2 p = v_uv * aspect * u_scale;\n  float noise = noiseAt(p) * 0.6 + noiseAt(p * 2.0) * 0.3 + noiseAt(p * 4.0) * 0.1;\n  float direction = v_uv.x;\n  if (u_direction == 1) direction = 1.0 - v_uv.x;\n  else if (u_direction == 2) direction = v_uv.y;\n  else if (u_direction == 3) direction = length((v_uv - 0.5) * aspect) / length(aspect * 0.5);\n  float field = direction * 0.65 + noise * 0.35;\n  float reveal = 0.5 - 0.5 * cos(TAU * u_progress);\n  float threshold = mix(-u_softness, 1.0 + u_softness, reveal);\n  float mask = 1.0 - smoothstep(threshold - u_softness, threshold + u_softness, field);\n  fragColor = texture(u_source, v_uv) * mask;\n}\n"
    },
