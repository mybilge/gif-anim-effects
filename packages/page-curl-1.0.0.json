{
  "metadata": {
    "schemaVersion": 1,
    "id": "page-curl",
    "name": {
      "tr": "Sayfa kıvrımı",
      "en": "Page curl"
    },
    "description": {
      "tr": "Fotoğrafın bir köşesi gölgeli bir kâğıt yüzeyi gibi kıvrılıp geri kapanır.",
      "en": "A picture corner curls like shaded paper and then settles back."
    },
    "category": "depth",
    "kind": "animation",
    "version": "1.0.0",
    "minimumEngineVersion": "0.4.0",
    "engineType": "glsl",
    "entry": "effect.frag",
    "parameters": [
      {
        "id": "corner",
        "type": "choice",
        "label": {
          "tr": "Köşe",
          "en": "Corner"
        },
        "description": {
          "tr": "Kıvrılacak köşeyi seçer.",
          "en": "Selects the corner to curl."
        },
        "default": 0,
        "options": [
          {
            "value": 0,
            "label": {
              "tr": "Sağ üst",
              "en": "Top right"
            }
          },
          {
            "value": 1,
            "label": {
              "tr": "Sol üst",
              "en": "Top left"
            }
          },
          {
            "value": 2,
            "label": {
              "tr": "Sağ alt",
              "en": "Bottom right"
            }
          },
          {
            "value": 3,
            "label": {
              "tr": "Sol alt",
              "en": "Bottom left"
            }
          }
        ]
      },
      {
        "id": "amount",
        "type": "slider",
        "label": {
          "tr": "Kıvrılma miktarı",
          "en": "Curl amount"
        },
        "description": {
          "tr": "Kıvrılmanın kısa kenara göre derinliğini ayarlar; sıfırda fotoğraf korunur.",
          "en": "Sets curl depth relative to the shorter edge; zero preserves the picture."
        },
        "min": 0,
        "max": 1,
        "step": 0.05,
        "default": 0.7
      },
      {
        "id": "shadow",
        "type": "slider",
        "label": {
          "tr": "Gölge",
          "en": "Shadow"
        },
        "description": {
          "tr": "Kıvrımın fotoğrafa düşürdüğü gölgeyi ayarlar.",
          "en": "Sets the shadow cast by the curl onto the picture."
        },
        "min": 0,
        "max": 1,
        "step": 0.05,
        "default": 0.4
      }
    ],
    "durationBehavior": "loop",
    "loopBehavior": "seamless",
    "randomness": "none",
    "capabilities": {
      "alpha": true,
      "webgl": 2,
      "platforms": [
        "android",
        "windows",
        "web"
      ],
      "cost": "medium"
    },
