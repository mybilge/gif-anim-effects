  "files": {
    "effect.frag": {
      "encoding": "utf8",
      "content": "uniform int u_corner;\nuniform float u_amount;\nuniform float u_shadow;\nconst float PI = 3.14159265359;\nvec2 cornerUv(vec2 uv) {\n  if (u_corner == 1 || u_corner == 3) uv.x = 1.0 - uv.x;\n  if (u_corner >= 2) uv.y = 1.0 - uv.y;\n  return uv;\n}\nvec4 sourceAt(vec2 uv) {\n  if (any(lessThan(uv, vec2(0.0))) || any(greaterThan(uv, vec2(1.0)))) return vec4(0.0);\n  return texture(u_source, cornerUv(uv));\n}\nvoid main() {\n  float travel = u_amount * (0.5 - 0.5 * cos(2.0 * PI * u_progress)) * 1.25;\n  if (travel < 0.00001) { fragColor = texture(u_source, v_uv); return; }\n  vec2 aspect = u_resolution / min(u_resolution.x, u_resolution.y);\n  vec2 p = cornerUv(v_uv) * aspect;\n  vec2 normal = normalize(vec2(1.0));\n  float distance = dot(p - aspect, normal) + travel;\n  float radius = travel / PI;\n  if (distance <= 0.0) {\n    vec4 c = texture(u_source, v_uv);\n    c.rgb *= 1.0 - exp(distance / (radius * 0.4)) * u_shadow * 0.45;\n    fragColor = c;\n  } else if (distance > radius) {\n    fragColor = vec4(0.0);\n  } else {\n    float angle = asin(clamp(distance / radius, 0.0, 1.0));\n    vec4 front = sourceAt((p + normal * (radius * angle - distance)) / aspect);\n    vec4 back = sourceAt((p + normal * (radius * (PI - angle) - distance)) / aspect);\n    front.rgb *= 0.65 + 0.35 * cos(angle);\n    back.rgb = mix(back.rgb, vec3(back.a * 0.92), 0.7) * (0.65 + 0.35 * cos(angle));\n    fragColor = back + front * (1.0 - back.a);\n  }\n}\n"
    },
