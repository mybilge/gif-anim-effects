{
  "metadata": {
    "schemaVersion": 1,
    "id": "scroll-right",
    "name": {
      "tr": "Sağa kaydır",
      "en": "Scroll right"
    },
    "description": {
      "tr": "Görseli tuval sınırından sararak kesintisiz kaydırır.",
      "en": "Scrolls the image continuously, wrapping at canvas edges."
    },
    "category": "motion",
    "kind": "animation",
    "version": "1.0.0",
    "minimumEngineVersion": "0.4.0",
    "engineType": "glsl",
    "entry": "effect.frag",
    "parameters": [
      {
        "id": "scale",
        "type": "slider",
        "label": {
          "tr": "Görsel boyutu",
          "en": "Picture size"
        },
        "description": {
          "tr": "Görsel boyutu değerini ayarlar.",
          "en": "Adjusts picture size."
        },
        "min": 0.4,
        "max": 1,
        "step": 0.05,
        "default": 0.85
      }
    ],
    "durationBehavior": "loop",
    "loopBehavior": "seamless",
    "randomness": "none",
    "capabilities": {
