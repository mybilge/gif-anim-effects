{
  "metadata": {
    "schemaVersion": 1,
    "id": "invert-colors",
    "name": {
      "tr": "Renkleri tersle",
      "en": "Invert colors"
    },
    "description": {
      "tr": "Alpha kanalını koruyarak renk kanallarını ters çevirir.",
      "en": "Inverts color channels while preserving alpha."
    },
    "category": "filters",
    "kind": "filter",
    "version": "1.0.0",
    "minimumEngineVersion": "0.4.0",
    "engineType": "glsl",
    "entry": "effect.frag",
    "parameters": [
      {
        "id": "amount",
        "type": "slider",
        "label": {
          "tr": "Miktar",
          "en": "Amount"
        },
        "description": {
          "tr": "Miktar değerini ayarlar.",
          "en": "Adjusts amount."
        },
        "min": 0,
        "max": 1,
        "step": 0.05,
        "default": 1
      }
    ],
    "durationBehavior": "static",
    "loopBehavior": "none",
    "randomness": "none",
    "capabilities": {
      "alpha": true,
      "webgl": 2,
      "platforms": [
        "android",
        "windows",
        "web"
      ],
      "cost": "low"
    },
    "thumbnail": "thumbnail.webp",
    "preview": "preview.webp",
    "assets": [
      {
        "path": "thumbnail.webp",
        "source": "Original GIF Anim synthetic calibration image, rendered by tooling",
