  "files": {
    "effect.frag": {
      "encoding": "utf8",
      "content": "uniform float u_amount;\nvec4 sourceAt(vec2 uv) {\n  if (any(lessThan(uv, vec2(0.0))) || any(greaterThan(uv, vec2(1.0)))) return vec4(0.0);\n  return texture(u_source, uv);\n}\nvoid main() {\n  vec2 p = v_uv - 0.5;\n  float radius = max(abs(p.x), abs(p.y)) * 2.0;\n  float base = 1.5 + u_amount * 1.5;\n  float band = floor(log(max(radius, 0.00001)) / log(base) - u_progress);\n  float scale = pow(base, band + u_progress);\n  fragColor = sourceAt(p / scale * 0.5 + 0.5);\n}\n"
    },
