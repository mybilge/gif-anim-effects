  "files": {
    "effect.frag": {
      "encoding": "utf8",
      "content": "uniform float u_amount;\nconst float TAU = 6.28318530718;\nvec4 sourceAt(vec2 uv) {\n  if (any(lessThan(uv, vec2(0.0))) || any(greaterThan(uv, vec2(1.0)))) return vec4(0.0);\n  return texture(u_source, uv);\n}\nmat2 rotation(float a) { float c = cos(a), s = sin(a); return mat2(c, -s, s, c); }\nvoid main() {\n  vec2 p = rotation(TAU * u_progress) * (v_uv - 0.5);\n  bool colorHalf = p.x > 0.0;\n  if (length(p - vec2(0.0, 0.23)) < 0.23) colorHalf = false;\n  if (length(p + vec2(0.0, 0.23)) < 0.23) colorHalf = true;\n  if (length(p - vec2(0.0, 0.23)) < 0.055 || length(p + vec2(0.0, 0.23)) < 0.055) colorHalf = !colorHalf;\n  vec4 c = sourceAt(v_uv);\n  if (colorHalf) c.rgb = vec3(step(u_amount * c.a, dot(c.rgb, vec3(0.2126, 0.7152, 0.0722)))) * c.a;\n  fragColor = length(p) < 0.46 ? c : vec4(0.0);\n}\n"
    },
